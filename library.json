{
  "name": "ConectividadeESP32",
  "version": "4.0.0",
  "description": "Gerenciamento não-bloqueante de WiFi e MQTT para ESP32 (API em português e inglês). Reconexão automática, TLS e AWS IoT Core com certificados no LittleFS, fila offline, credenciais no Preferences e portal de configuração WiFi (modo AP) com HTML personalizável.",
  "keywords": [
    "wifi",
    "mqtt",
    "aws",
    "iot",
    "esp32",
    "nao-bloqueante",
    "non-blocking",
    "fila",
    "offline",
    "littlefs",
    "preferences",
    "captive-portal",
    "wifi-manager"
  ],
  "homepage": "https://professorthiago.github.io/ConectividadeESP32/",
  "repository": {
    "type": "git",
    "url": "https://github.com/professorThiago/ConectividadeESP32.git"
  },
  "authors": [
    {
      "name": "professorThiago",
      "url": "https://github.com/professorThiago",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "dependencies": [
    {
      "owner": "knolleary",
      "name": "PubSubClient",
      "version": "^2.8"
    },
    {
      "name": "DebugManager",
      "version": "https://github.com/professorThiago/DebugManager.git"
    }
  ],
  "export": {
    "include": [
      "src",
      "examples",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "library.json",
      "library.properties"
    ]
  }
}
